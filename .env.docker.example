# ============================================
# ตัวอย่าง .env สำหรับ Docker (Ubuntu host)
# คัดลอกเป็น .env แล้วแก้ค่าให้ตรงกับ server
# ============================================

# Database — MariaDB ภายนอก (ไม่รันใน Docker)
DATABASE_URL="mysql://<user>:<password>@<db-host>:3306/qa_external?schema=public&authPlugin=mysql_native_password"

# NextAuth
NEXTAUTH_SECRET="สร้างค่าใหม่สำหรับ production เช่น: openssl rand -base64 32"
NEXTAUTH_URL="https://your-domain.com"

# Google OAuth (ถ้าใช้)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
NODE_ENV="production"

# โฟลเดอร์อัปโหลด (ใน Docker ใช้ /app/public/uploads ให้ตรงกับ volume)
# ถ้ารูปอัปโหลดใหม่โหลดไม่ขึ้น (404) ให้ตั้งค่านี้
UPLOAD_DIR="/app/public/uploads"

# Gemini (ถ้าใช้ AI)
GEMINI_API_KEY=""
