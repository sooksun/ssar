# Database Configuration
# MySQL 8.0 connection string
# Format: mysql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="mysql://app:app123@localhost:3306/qa_external?schema=public"

# NextAuth.js Configuration
# Secret key for JWT encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Base URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for future implementation)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Node Environment
# Options: development, production, test
NODE_ENV="development"

# ─────────────────────────────────────────────
# โฟลเดอร์เก็บไฟล์อัปโหลด (evidence, lesson-plans, teaching-media ฯลฯ)
# ไม่ตั้งค่า = ใช้ <project>/public/uploads
# ใน Docker ตั้งให้ตรงกับ volume ที่ mount เช่น /app/public/uploads
# UPLOAD_DIR="/app/public/uploads"
# ชื่อสำรองที่โค้ดรองรับ (ใช้ตัวใดตัวหนึ่ง — UPLOAD_DIR มาก่อน)
# PUBLIC_UPLOAD_DIR=""

# ─────────────────────────────────────────────
# Google Gemini — ใช้กับฟีเจอร์ AI วิเคราะห์หลักฐาน (/api/evidence/[id]/analyze)
# ไม่ตั้งค่า = ระบบ fallback ไปสร้างผลจาก metadata แทน (ไม่พัง แต่ไม่มี AI)
GEMINI_API_KEY=""
