generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// สำนักงานเขตพื้นที่การศึกษา (สพป./สพม.) — รองรับหลายสังกัด และทุกโรงเรียนในสพฐ.
model EducationServiceArea {
  id        BigInt         @id @default(autoincrement())
  code      String         @unique // รหัสเขต เช่น ภาค 1, กทม.1
  nameTh    String // ชื่อเขตพื้นที่
  province  String?
  sortNo    Int            @default(0)
  del       Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  schools   School[]
  userRoles UserAreaRole[]

  @@map("educationservicearea")
}

model School {
  id                       BigInt                    @id @default(autoincrement())
  sc_id                    BigInt                    @unique
  name                     String
  area                     EducationServiceArea?     @relation(fields: [areaId], references: [id])
  areaId                   BigInt? // สังกัดเขตพื้นที่ (รองรับหลายสังกัด/สพฐ.)
  area_name                String? // เก็บชื่อเดิมถ้าไม่มี areaId (backward compat)
  province                 String?
  level_type               String?
  del                      Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  users                    UserSchoolRole[]
  primaryUsers             User[]                    @relation("PrimarySchool")
  evidence                 Evidence[]
  evidenceFiles            EvidenceFile[]
  evidenceReviews          EvidenceReview[]
  sarReports               SarReport[]
  external                 ExternalAssessment[]
  evaluations              Evaluation[]
  externalEvaluations      ExternalEvaluation[]
  auditLogs                AuditLog[]
  selfAssessmentScopes     SelfAssessmentScope[]
  teachingMedia            TeachingMedia[]
  teachingMediaFiles       TeachingMediaFile[]
  lessonPlans              LessonPlan[]
  lessonPlanFiles          LessonPlanFile[]
  paAgreements             PAAgreement[]
  paSummaries              PASummary[]
  paTeacherDocuments       PATeacherDocument[]
  teacherSarDocuments      TeacherSarDocument[]
  teacherIdPlans           TeacherIdPlan[]
  communityTeachingRecords CommunityTeachingRecord[]
  developmentSummaries     DevelopmentSummary[]
  projects                 Project[]
  projectFiles             ProjectFile[]

  @@index([areaId])
  @@map("school")
}

/// บทบาทผู้ใช้: ระดับโรงเรียน (TEACHER, SCHOOL_DIRECTOR, SCHOOL_ADMIN) ระดับเขต (AREA_HEAD_OFFICE, AREA_ADMIN) + ADMIN, QA_LEAD, ASSESSOR
model Role {
  id            BigInt           @id @default(autoincrement())
  code          String           @unique
  name          String
  users         UserSchoolRole[]
  userAreaRoles UserAreaRole[]

  @@map("role")
}

model User {
  id                       BigInt                    @id @default(autoincrement())
  fullName                 String
  email                    String                    @unique
  password                 String? // Credentials (bcrypt)
  phone                    String?
  del                      Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  primarySchool            School?                   @relation("PrimarySchool", fields: [schoolId], references: [sc_id])
  schoolId                 BigInt?
  schoolRoles              UserSchoolRole[]
  areaRoles                UserAreaRole[]
  evidenceOwned            Evidence[]                @relation("Owner")
  evidenceFiles            EvidenceFile[]            @relation("Uploader")
  reviews                  EvidenceReview[]          @relation("Reviewer")
  audits                   AuditLog[]                @relation("Actor")
  projectsResponsible      Project[]                 @relation("ProjectResponsible")
  paTeacherDocuments       PATeacherDocument[]       @relation("PATeacherDocumentOwner")
  teacherSarDocuments      TeacherSarDocument[]      @relation("TeacherSarDocumentOwner")
  teacherIdPlans           TeacherIdPlan[]           @relation("TeacherIdPlanOwner")
  communityTeachingRecords CommunityTeachingRecord[] @relation("CommunityTeachingRecordOwner")

  @@map("user")
}

/// บทบาทระดับโรงเรียน: Teacher บันทึกข้อมูลโดยตรง, School_director สร้างรายงานจากข้อมูลครู, School_admin จัดการโรงเรียน
model UserSchoolRole {
  id        BigInt   @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    BigInt
  school    School   @relation(fields: [schoolId], references: [sc_id])
  schoolId  BigInt
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    BigInt
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, schoolId])
  @@map("userschoolrole")
}

/// บทบาทระดับเขตพื้นที่: Area_head_office / Area_admin เห็นทุกโรงเรียนในเขต (รองรับหลายสังกัด สพฐ.)
model UserAreaRole {
  id        BigInt               @id @default(autoincrement())
  user      User                 @relation(fields: [userId], references: [id])
  userId    BigInt
  area      EducationServiceArea @relation(fields: [areaId], references: [id])
  areaId    BigInt
  role      Role                 @relation(fields: [roleId], references: [id])
  roleId    BigInt
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, areaId])
  @@index([areaId])
  @@map("userarearole")
}

model EduLevel {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique // EARLY_CHILDHOOD, BASIC
  nameTh               String
  standards            QAStandard[]
  selfAssessmentScopes SelfAssessmentScope[]
  indicatorScales      IndicatorScale[]

  @@map("edulevel")
}

model QAStandard {
  id                       BigInt                    @id @default(autoincrement())
  level                    EduLevel                  @relation(fields: [levelId], references: [id])
  levelId                  Int
  code                     String
  nameTh                   String
  sortNo                   Int
  indicators               QAIndicator[]
  evaluations              Evaluation[]
  selfAssessmentIndicators SelfAssessmentIndicator[]

  @@unique([levelId, code])
  @@map("qastandard")
}

model QAIndicator {
  id                       BigInt                     @id @default(autoincrement())
  standard                 QAStandard                 @relation(fields: [standardId], references: [id])
  standardId               BigInt
  code                     String
  nameTh                   String
  descriptionTh            String?
  sortNo                   Int
  subItems                 QASubIndicator[]
  evidence                 Evidence[]
  evaluations              Evaluation[]
  selfAssessmentIndicators SelfAssessmentIndicator[]
  indicatorScales          IndicatorScale[]
  teachingMedia            TeachingMedia[]
  evidenceMappings         EvidenceIndicatorMapping[]
  projects                 Project[]

  @@unique([standardId, code])
  @@map("qaindicator")
}

model QASubIndicator {
  id          BigInt      @id @default(autoincrement())
  indicator   QAIndicator @relation(fields: [indicatorId], references: [id])
  indicatorId BigInt
  itemNo      Int
  textTh      String

  @@unique([indicatorId, itemNo])
  @@map("qasubindicator")
}

model Evidence {
  id                  BigInt                       @id @default(autoincrement())
  school              School                       @relation(fields: [schoolId], references: [sc_id])
  schoolId            BigInt
  indicator           QAIndicator                  @relation(fields: [indicatorId], references: [id])
  indicatorId         BigInt
  fiscalYear          Int // ปีงบประมาณ (ต.ค.→ก.ย.)
  academicYear        Int // ปีการศึกษา (พ.ค.→เม.ย.)
  title               String
  description         String?
  status              EvidenceStatus               @default(PENDING)
  evidenceCode        String?
  owner               User?                        @relation("Owner", fields: [ownerUserId], references: [id])
  ownerUserId         BigInt?
  privacyLevel        PrivacyLevel                 @default(INTERNAL)
  del                 Boolean                      @default(false)
  createdBy           BigInt?
  updatedBy           BigInt?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  files               EvidenceFile[]
  reviews             EvidenceReview[]
  selfAssessmentLinks SelfAssessmentEvidenceLink[]
  externalEvaluations ExternalEvaluation[]
  paMappings          PAEvidenceMapping[]
  /// หลักฐาน 1 ชิ้นเชื่อมโยงกับตัวชี้วัดได้หลายมุมมอง (ปฐมวัย / ขั้นพื้นฐาน / ครูผู้ช่วย)
  indicatorMappings   EvidenceIndicatorMapping[]
  // PRD: indicatorCodes, evidenceType, AI, PDPA
  indicatorCodes      Json? // รหัสตัวชี้วัดเพิ่มเติม เช่น ["1.1","2.1"]
  evidenceType        String? // LESSON_PLAN, TEACHING_MEDIA, ASSESSMENT, STUDENT_WORK, CLASSROOM_PHOTO, REFLECTION, ACTION_RESEARCH, OTHER
  aiSummary           String?                      @db.Text // สรุปเนื้อหา (จาก AI) — เก็บข้อความยาวได้
  aiKeywords          Json? // คำสำคัญ (จาก AI)
  aiQualityCheck      Json? // ตรวจคุณภาพเบื้องต้น (จาก AI)
  aiSuggestions       String?                      @db.Text // ข้อเสนอแนะปรับปรุง (จาก AI)
  pdpaChecked         Boolean? // ตรวจ PDPA (ถ้าเปิดใช้)
  pdpaRiskLevel       String? // ระดับความเสี่ยง PDPA

  // ตาข่ายกันพลาดระดับฐานข้อมูล: รหัสหลักฐานห้ามซ้ำในตัวชี้วัด+ปีเดียวกัน
  // (evidenceCode เป็น nullable — MySQL ยอมให้มีหลาย NULL ในดัชนี unique ได้)
  @@unique([indicatorId, fiscalYear, evidenceCode], name: "evidence_code_per_indicator_year")
  @@index([schoolId, fiscalYear, indicatorId, status])
  @@index([schoolId, academicYear, indicatorId, status])
  // รองรับหน้ารายการหลักฐาน: WHERE schoolId IN (...) AND del = false ORDER BY createdAt DESC
  @@index([schoolId, del, createdAt])
  // รองรับการนับตามตัวชี้วัด/สถานะ (dashboard + รายงานความพร้อม)
  @@index([indicatorId, status])
  @@map("evidence")
}

/// การเชื่อมโยงหลักฐานกับตัวชี้วัดหลายมุมมอง — หลักฐาน 1 ชิ้นวิเคราะห์เชื่อมโยงได้ทั้ง ปฐมวัย / ขั้นพื้นฐาน / ครูผู้ช่วย
model EvidenceIndicatorMapping {
  id          BigInt      @id @default(autoincrement())
  evidence    Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceId  BigInt
  indicator   QAIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  indicatorId BigInt
  reason      String? // เหตุผล/หมายเหตุ (จาก AI หรือผู้ใช้)
  source      String? // AI | USER
  createdAt   DateTime    @default(now())

  @@unique([evidenceId, indicatorId])
  @@index([evidenceId])
  @@map("evidenceindicatormapping")
}

enum EvidenceStatus {
  MISSING
  PENDING
  READY
  APPROVED
  REJECTED
}

enum PrivacyLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

model EvidenceFile {
  id           BigInt              @id @default(autoincrement())
  evidence     Evidence            @relation(fields: [evidenceId], references: [id])
  evidenceId   BigInt
  school       School              @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  fileName     String
  mimeType     String?
  fileSize     Int?
  storageType  EvidenceStorageType @default(URL)
  storagePath  String?
  driveFileId  String?
  externalUrl  String?
  thumbnailUrl String?
  fileUrls     Json? // สำหรับเก็บ array ของรูปภาพหลายไฟล์ (JSON array)
  checksumSha1 String?
  versionNo    Int                 @default(1)
  uploader     User?               @relation("Uploader", fields: [uploadedBy], references: [id])
  uploadedBy   BigInt?
  uploadedAt   DateTime            @default(now())
  isPrimary    Boolean             @default(false)
  note         String?
  del          Boolean             @default(false)
  reviews      EvidenceReview[]

  @@index([evidenceId])
  @@index([evidenceId, isPrimary])
  @@index([schoolId])
  @@map("evidencefile")
}

enum StorageType {
  LOCAL
  GDRIVE
  URL
}

enum EvidenceStorageType {
  YOUTUBE
  GDRIVE
  URL
  CANVA
  LINK
}

model EvidenceReview {
  id             BigInt        @id @default(autoincrement())
  evidence       Evidence      @relation(fields: [evidenceId], references: [id])
  evidenceId     BigInt
  evidenceFile   EvidenceFile? @relation(fields: [evidenceFileId], references: [id])
  evidenceFileId BigInt?
  school         School        @relation(fields: [schoolId], references: [sc_id])
  schoolId       BigInt
  reviewer       User          @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerId     BigInt
  reviewStatus   ReviewStatus  @default(NEED_MORE)
  score          Decimal?      @db.Decimal(5, 2)
  comment        String?
  reviewedAt     DateTime      @default(now())

  @@index([evidenceFileId])
  @@map("evidencereview")
}

enum ReviewStatus {
  NEED_MORE
  ACCEPTED
  REJECTED
}

model Evaluation {
  id          BigInt       @id @default(autoincrement())
  school      School       @relation(fields: [schoolId], references: [sc_id])
  schoolId    BigInt
  fiscalYear  Int
  standard    QAStandard   @relation(fields: [standardId], references: [id])
  standardId  BigInt
  indicator   QAIndicator? @relation(fields: [indicatorId], references: [id])
  indicatorId BigInt?
  evalType    EvalType     @default(SELF)
  score       Decimal?     @db.Decimal(5, 2)
  comment     String?
  createdBy   BigInt?
  createdAt   DateTime     @default(now())

  @@index([schoolId, fiscalYear])
  @@map("evaluation")
}

enum EvalType {
  SELF
  EXTERNAL
}

model SarReport {
  id          BigInt      @id @default(autoincrement())
  school      School      @relation(fields: [schoolId], references: [sc_id])
  schoolId    BigInt
  fiscalYear  Int
  title       String
  storageType StorageType
  storagePath String?
  driveFileId String?
  externalUrl String?
  versionNo   Int         @default(1)
  status      SarStatus   @default(DRAFT)
  createdBy   BigInt?
  updatedBy   BigInt?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("sarreport")
}

enum SarStatus {
  DRAFT
  READY
  SUBMITTED
  APPROVED
}

/// PRD 2.5: สรุปผลพัฒนาอย่างเข้ม — รองรับหลายปีการศึกษา รายงานภาคเรียนละ 1 ครั้ง (assessmentRound 1=ภาค 1, 2=ภาค 2 ต่อปี)
model DevelopmentSummary {
  id                  BigInt   @id @default(autoincrement())
  school              School   @relation(fields: [schoolId], references: [sc_id])
  schoolId            BigInt
  userId              BigInt // ครู/ผู้รับการประเมิน
  fiscalYear          Int // ปีงบประมาณ (ใช้ต่อเนื่องหลายปี)
  assessmentRound     Int      @default(1) // ภาคเรียน: 1 = ภาค 1, 2 = ภาค 2 (ต่อปี) — รายงานสรุปภาคเรียนละ 1 ครั้ง
  overallScore        Decimal? @db.Decimal(5, 2)
  overallPassed       Boolean?
  professionalScore   Decimal? @db.Decimal(5, 2)
  professionalPassed  Int? // จำนวนข้อที่ผ่าน
  professionalTotal   Int?
  socialScore         Decimal? @db.Decimal(5, 2)
  socialPassed        Int?
  socialTotal         Int?
  personalScore       Decimal? @db.Decimal(5, 2)
  personalPassed      Int?
  personalTotal       Int?
  totalEvidence       Int      @default(0)
  totalFiles          Int      @default(0)
  totalVideoLinks     Int      @default(0)
  totalAnalysisJobs   Int      @default(0)
  evidenceByIndicator Json? // { "indicatorCode": count หรือรายการ }
  aiInsights          Json? // teachingStrengths, areasForImprovement, recommendations
  domainSummaries     Json?
  indicatorNarratives Json? // { "PRO_1.1": "ข้อความบรรยาย...", ... }
  summaryNarrative    String?  @db.Text
  passCriteria        Json? // snapshot เกณฑ์ผ่านที่ใช้
  deckPath            String?
  deckMarkdown        String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([schoolId, userId, fiscalYear, assessmentRound], name: "devsum_school_user_year_round")
  @@index([schoolId, fiscalYear])
  @@map("developmentsummary")
}

model ExternalAssessment {
  id                  BigInt               @id @default(autoincrement())
  school              School               @relation(fields: [schoolId], references: [sc_id])
  schoolId            BigInt
  fiscalYear          Int
  visitDate           DateTime
  assessorsNote       String?
  agendaUrl           String?
  reportUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  externalEvaluations ExternalEvaluation[]

  @@map("externalassessment")
}

model ExternalEvaluation {
  id                   BigInt              @id @default(autoincrement())
  evidence             Evidence            @relation(fields: [evidenceId], references: [id])
  evidenceId           BigInt
  school               School              @relation(fields: [schoolId], references: [sc_id])
  schoolId             BigInt
  externalAssessment   ExternalAssessment? @relation(fields: [externalAssessmentId], references: [id])
  externalAssessmentId BigInt?
  evaluatorName        String
  evaluatorOrg         String?
  evaluationDate       DateTime            @default(now())
  score                Decimal?            @db.Decimal(5, 2)
  strengths            String?
  weaknesses           String?
  recommendations      String?
  attachmentUrl        String?
  createdBy            BigInt?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([evidenceId, evaluatorName])
  @@index([evidenceId])
  @@index([schoolId])
  @@index([externalAssessmentId])
  @@map("externalevaluation")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actor       User?    @relation("Actor", fields: [actorId], references: [id])
  actorId     BigInt?
  school      School?  @relation(fields: [schoolId], references: [sc_id])
  schoolId    BigInt?
  action      String
  targetTable String
  targetId    BigInt?
  payload     Json?
  createdAt   DateTime @default(now())

  @@map("auditlog")
}

/// ส่วนนี้เพิ่มเข้ามาใหม่
/// ขอบเขตการประเมินตนเอง 1 ชุด = 1 โรงเรียน + 1 ปีงบ + 1 ระดับ (ปฐมวัย/พื้นฐาน)
model SelfAssessmentScope {
  id         BigInt   @id @default(autoincrement())
  school     School   @relation(fields: [schoolId], references: [sc_id])
  schoolId   BigInt
  fiscalYear Int // ปีงบประมาณแบบไทย (เช่น 2567)
  level      EduLevel @relation(fields: [levelId], references: [id])
  levelId    Int

  indicators SelfAssessmentIndicator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 1 โรงเรียน + 1 ปีงบ + 1 ระดับ มี scope ได้ชุดเดียว
  @@unique([schoolId, fiscalYear, levelId], name: "uq_scope_school_year_level")
  @@map("selfassessmentscope")
}

/// ระดับการประเมินต่อตัวชี้วัด (self-assessment ตาม indicator)
model SelfAssessmentIndicator {
  id BigInt @id @default(autoincrement())

  scope   SelfAssessmentScope @relation(fields: [scopeId], references: [id])
  scopeId BigInt

  standard   QAStandard @relation(fields: [standardId], references: [id])
  standardId BigInt

  indicator   QAIndicator @relation(fields: [indicatorId], references: [id])
  indicatorId BigInt

  /// เป้าหมายที่ตั้งไว้ (1–5) ตามเกณฑ์ สมศ.
  targetLevel   Int? @db.TinyInt
  /// คะแนนประเมินตนเองจริง (1–5)
  selfScore     Int? @db.TinyInt
  /// คะแนนประเมินภายนอก (1–5)
  externalScore Int? @db.TinyInt

  evidenceSummary String? // สรุปหลักฐานสำคัญ
  strength        String? // จุดเด่น
  weakness        String? // จุดที่ควรพัฒนา
  improvementPlan String? // แผนพัฒนา
  isBestPractice  Boolean @default(false)

  evidenceLinks SelfAssessmentEvidenceLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ตัวชี้วัดหนึ่งถูกประเมินได้ครั้งเดียวใน 1 scope
  @@unique([scopeId, indicatorId], name: "uq_scope_indicator")
  @@index([standardId])
  @@map("selfassessmentindicator")
}

/// ลิงก์ตัวประเมินตนเอง → หลักฐานที่แนบในระบบ
model SelfAssessmentEvidenceLink {
  id BigInt @id @default(autoincrement())

  selfIndicator   SelfAssessmentIndicator @relation(fields: [selfIndicatorId], references: [id])
  selfIndicatorId BigInt

  evidence   Evidence @relation(fields: [evidenceId], references: [id])
  evidenceId BigInt

  note String? // เช่น ใช้ประกอบเกณฑ์ระดับ 3 ข้อใดบ้าง

  createdAt DateTime @default(now())

  @@map("selfassessmentevidencelink")
}

/// เกณฑ์คำอธิบายคะแนน 1–5 ของแต่ละตัวชี้วัด (ตั้งค่าจากเอกสาร สมศ.)
model IndicatorScale {
  id BigInt @id @default(autoincrement())

  level   EduLevel @relation(fields: [levelId], references: [id])
  levelId Int

  indicator   QAIndicator @relation(fields: [indicatorId], references: [id])
  indicatorId BigInt

  score         Int    @db.TinyInt // 1–5
  labelTh       String // ชื่อสั้น ๆ เช่น "ต่อเนื่อง ≥ 3 ปี"
  descriptionTh String // คำอธิบายเต็มตามเกณฑ์ สมศ.

  createdAt DateTime @default(now())

  /// หนึ่ง indicator + หนึ่ง score มี config ได้หนึ่งแถว
  @@unique([indicatorId, score], name: "uq_indicator_score")
  @@index([levelId])
  @@map("indicatorscale")
}

/// ระบบบันทึกสื่อการสอน (สำหรับข้อ 2.6 - การใช้สื่อ อุปกรณ์ และระบบเทคโนโลยี)
model TeachingMedia {
  id           BigInt              @id @default(autoincrement())
  school       School              @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  indicator    QAIndicator         @relation(fields: [indicatorId], references: [id])
  indicatorId  BigInt // ควรเป็น 2.6 สำหรับระดับพื้นฐาน
  academicYear Int // ปีการศึกษา (พ.ค.→เม.ย.)
  fiscalYear   Int // ปีงบประมาณ (ต.ค.→ก.ย.)
  title        String // ชื่อสื่อ
  description  String? // รายละเอียดสื่อ
  teacherName  String // ชื่อครูผู้ผลิตสื่อ
  teacherId    BigInt? // ID ของครู (ถ้ามีในระบบ)
  status       TeachingMediaStatus @default(DRAFT)
  del          Boolean             @default(false)
  createdBy    BigInt?
  updatedBy    BigInt?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  files TeachingMediaFile[]

  @@index([schoolId, academicYear, indicatorId])
  @@index([schoolId, fiscalYear, indicatorId])
  @@index([schoolId, academicYear])
  @@index([schoolId, fiscalYear])
  @@map("teachingmedia")
}

enum TeachingMediaStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// ไฟล์ที่เกี่ยวข้องกับสื่อการสอน (ภาพ/วิดีโอการนำสื่อไปใช้)
model TeachingMediaFile {
  id              BigInt              @id @default(autoincrement())
  teachingMedia   TeachingMedia       @relation(fields: [teachingMediaId], references: [id])
  teachingMediaId BigInt
  school          School              @relation(fields: [schoolId], references: [sc_id])
  schoolId        BigInt
  fileName        String
  mimeType        String?
  fileSize        Int?
  storageType     EvidenceStorageType @default(URL)
  storagePath     String?
  driveFileId     String?
  externalUrl     String?
  thumbnailUrl    String?
  fileUrls        Json? // สำหรับเก็บ array ของรูปภาพหลายไฟล์
  description     String? // คำอธิบายไฟล์ (เช่น "ภาพการนำสื่อไปใช้ในชั้นเรียน")
  uploadedBy      BigInt?
  uploadedAt      DateTime            @default(now())
  isPrimary       Boolean             @default(false)
  del             Boolean             @default(false)

  @@index([teachingMediaId])
  @@index([teachingMediaId, isPrimary])
  @@index([schoolId])
  @@map("teachingmediafile")
}

/// ระบบบันทึกแผนการสอนและบันทึกหลังแผน
model LessonPlan {
  id           BigInt           @id @default(autoincrement())
  school       School           @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  code         String? // รหัสแผนการสอน
  academicYear Int // ปีการศึกษา (พ.ค.→เม.ย.)
  fiscalYear   Int // ปีงบประมาณ (ต.ค.→ก.ย.)
  semester     Int? // ภาคเรียนที่ (1 หรือ 2)
  title        String // ชื่อแผนการสอน
  planType     String? // ประเภทแผน: แผนรายวิชา, แผนบูรณาการ
  grade        String? // ชั้น (อนุบาล 2 - ม.3)
  room         String? // ห้อง
  subject      String? // วิชา (ไทย คณิต วิทย์ อังกฤษ PBL อื่น ๆ)
  description  String? // รายละเอียด
  teacherName  String // ชื่อครูผู้สอน
  teacherId    BigInt? // ID ของครู (ถ้ามีในระบบ)
  planDate     DateTime? // วันที่ใช้แผน
  submittedAt  DateTime? // วันที่ส่งแผน
  reflection   String? // บันทึกหลังแผน (reflection)
  status       LessonPlanStatus @default(DRAFT)
  del          Boolean          @default(false)
  createdBy    BigInt?
  updatedBy    BigInt?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  files LessonPlanFile[]

  @@index([schoolId, academicYear])
  @@index([schoolId, fiscalYear])
  @@index([schoolId, academicYear, status])
  @@index([schoolId, fiscalYear, status])
  @@map("lessonplan")
}

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

/// ไฟล์ที่เกี่ยวข้องกับแผนการสอน (ไฟล์แผนการสอน, เอกสารประกอบ)
model LessonPlanFile {
  id           BigInt              @id @default(autoincrement())
  lessonPlan   LessonPlan          @relation(fields: [lessonPlanId], references: [id])
  lessonPlanId BigInt
  school       School              @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  fileName     String
  mimeType     String?
  fileSize     Int?
  storageType  EvidenceStorageType @default(URL)
  storagePath  String?
  driveFileId  String?
  externalUrl  String?
  thumbnailUrl String?
  fileUrls     Json? // สำหรับเก็บ array ของรูปภาพหลายไฟล์ (JSON array)
  fileType     LessonPlanFileType  @default(PLAN) // แผนการสอน หรือ บันทึกหลังแผน
  description  String? // คำอธิบายไฟล์
  uploadedBy   BigInt?
  uploadedAt   DateTime            @default(now())
  isPrimary    Boolean             @default(false)
  del          Boolean             @default(false)

  @@index([lessonPlanId])
  @@index([lessonPlanId, isPrimary])
  @@index([schoolId])
  @@map("lessonplanfile")
}

enum LessonPlanFileType {
  PLAN // ไฟล์แผนการสอน
  REFLECTION // ไฟล์บันทึกหลังแผน
  OTHER // ไฟล์อื่นๆ
}

// =============================================================================
// PA (Performance Agreement) Models - NEW
// =============================================================================

model PAAspect {
  id           BigInt         @id @default(autoincrement())
  code         String         @unique
  nameTh       String
  sortNo       Int
  description  String?
  maxScore     Int            @default(60)
  part         PAPart         @default(PART1)
  positionType PAPositionType @default(PRINCIPAL)

  indicators PAIndicator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([positionType])
  @@map("paaspect")
}

enum PAPart {
  PART1
  PART2
}

enum PAPositionType {
  TEACHER
  PRINCIPAL
  // มุมมองประเมินครูผู้ช่วย — มีอยู่จริงใน DB (paaspect) ตั้งแต่ก่อนหน้านี้
  // แต่หลุดจาก schema ทำให้ prisma diff เสนอ MODIFY ENUM ที่จะทำให้ค่านี้หาย
  ASSISTANT_TEACHER
}

model PAIndicator {
  id          BigInt   @id @default(autoincrement())
  aspect      PAAspect @relation(fields: [aspectId], references: [id])
  aspectId    BigInt
  code        String
  nameTh      String
  description String?  @db.Text
  sortNo      Int
  weight      Decimal? @db.Decimal(5, 2)

  evidenceMappings PAEvidenceMapping[]
  agreementItems   PAAgreementItem[]
  scales           PAIndicatorScale[]
  projects         Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aspectId, code])
  @@index([aspectId])
  @@map("paindicator")
}

model PAIndicatorScale {
  id            BigInt      @id @default(autoincrement())
  indicator     PAIndicator @relation(fields: [indicatorId], references: [id])
  indicatorId   BigInt
  score         Int         @db.TinyInt
  labelTh       String
  descriptionTh String?
  criteriaTh    String?

  createdAt DateTime @default(now())

  @@unique([indicatorId, score])
  @@map("paindicatorscale")
}

model PAConsideration {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique
  nameTh      String
  description String?
  maxScore    Int
  sortNo      Int

  challengeConsiderations PAChallengeConsideration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("paconsideration")
}

model PAAgreement {
  id           BigInt         @id @default(autoincrement())
  school       School         @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  userId       BigInt
  evaluatorId  BigInt?
  positionType PAPositionType @default(PRINCIPAL)

  fiscalYear Int
  startDate  DateTime
  endDate    DateTime
  status     PAStatus @default(DRAFT)
  totalScore Decimal? @db.Decimal(5, 2)
  part1Score Decimal? @db.Decimal(5, 2)
  part2Score Decimal? @db.Decimal(5, 2)
  isPassed   Boolean?
  passReason String?
  note       String?

  items     PAAgreementItem[]
  challenge PAChallengeItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  @@unique([userId, fiscalYear, positionType])
  @@index([schoolId, fiscalYear])
  @@index([status])
  @@index([positionType])
  @@map("paagreement")
}

enum PAStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  EVALUATED
  APPROVED
  REJECTED
}

model PAAgreementItem {
  id            BigInt      @id @default(autoincrement())
  agreement     PAAgreement @relation(fields: [agreementId], references: [id])
  agreementId   BigInt
  indicator     PAIndicator @relation(fields: [indicatorId], references: [id])
  indicatorId   BigInt
  score         Int?        @db.TinyInt
  scoreValue    Decimal?    @db.Decimal(5, 2)
  comment       String?
  evaluatorNote String?

  evidenceLinks PAEvidenceMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agreementId, indicatorId])
  @@index([agreementId])
  @@index([indicatorId])
  @@map("paagreementitem")
}

model PAChallengeItem {
  id          BigInt      @id @default(autoincrement())
  agreement   PAAgreement @relation(fields: [agreementId], references: [id])
  agreementId BigInt      @unique
  title       String
  description String?
  objectives  String?

  c1MethodScore   Int?     @db.TinyInt
  c1MethodComment String?
  c21QuantScore   Int?     @db.TinyInt
  c21QuantComment String?
  c22QualScore    Int?     @db.TinyInt
  c22QualComment  String?
  part2Total      Decimal? @db.Decimal(5, 2)

  considerations PAChallengeConsideration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pachallengeitem")
}

model PAChallengeConsideration {
  id              BigInt          @id @default(autoincrement())
  challenge       PAChallengeItem @relation(fields: [challengeId], references: [id])
  challengeId     BigInt
  consideration   PAConsideration @relation(fields: [considerationId], references: [id])
  considerationId BigInt
  score           Int?            @db.TinyInt
  scoreValue      Decimal?        @db.Decimal(5, 2)
  comment         String?

  evidenceLinks PAEvidenceMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, considerationId])
  @@map("pachallengeconsideration")
}

model PAEvidenceMapping {
  id                       BigInt                    @id @default(autoincrement())
  evidence                 Evidence                  @relation(fields: [evidenceId], references: [id])
  evidenceId               BigInt
  agreementItem            PAAgreementItem?          @relation(fields: [agreementItemId], references: [id])
  agreementItemId          BigInt?
  challengeConsideration   PAChallengeConsideration? @relation(fields: [challengeConsiderationId], references: [id])
  challengeConsiderationId BigInt?
  indicator                PAIndicator?              @relation(fields: [indicatorId], references: [id])
  indicatorId              BigInt?
  note                     String?
  relevanceLevel           Int?                      @db.TinyInt
  createdAt                DateTime                  @default(now())
  createdBy                BigInt?

  @@index([evidenceId])
  @@index([agreementItemId])
  @@index([challengeConsiderationId])
  @@index([indicatorId])
  @@map("paevidencemapping")
}

model PASummary {
  id                 BigInt   @id @default(autoincrement())
  school             School   @relation(fields: [schoolId], references: [sc_id])
  schoolId           BigInt
  userId             BigInt
  fiscalYear         Int
  p1AcademicScore    Decimal? @db.Decimal(5, 2)
  p2ManagementScore  Decimal? @db.Decimal(5, 2)
  p3InnovationScore  Decimal? @db.Decimal(5, 2)
  p4NetworkScore     Decimal? @db.Decimal(5, 2)
  p5DevelopmentScore Decimal? @db.Decimal(5, 2)
  part1Total         Decimal? @db.Decimal(5, 2)
  c1MethodScore      Decimal? @db.Decimal(5, 2)
  c2QuantScore       Decimal? @db.Decimal(5, 2)
  c2QualScore        Decimal? @db.Decimal(5, 2)
  part2Total         Decimal? @db.Decimal(5, 2)
  grandTotal         Decimal? @db.Decimal(5, 2)
  isPassed           Boolean?
  evaluationLevel    String?
  totalEvidenceCount Int      @default(0)
  qaLinkedCount      Int      @default(0)
  paLinkedCount      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fiscalYear])
  @@index([schoolId, fiscalYear])
  @@map("pasummary")
}

/// บันทึกไฟล์ PA 1/ส, PA 2/ส, PA 3/ส ของครู — ครู 1 คน บันทึก 1 ครั้งต่อปีการศึกษา ต่อโรงเรียน (ผูกกับ ครู, ปีการศึกษา, โรงเรียน)
model PATeacherDocument {
  id           BigInt   @id @default(autoincrement())
  school       School   @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  user         User     @relation("PATeacherDocumentOwner", fields: [userId], references: [id])
  userId       BigInt // ครูที่บันทึก (ผูกกับครู)
  academicYear Int // ปีการศึกษา (พ.ศ.)
  documentType String // PA1, PA2, PA3 (PA 1/ส, PA 2/ส, PA 3/ส)
  fileName     String
  storageType  String   @default("URL") // URL หรือ GDRIVE
  storagePath  String? // path ใน uploads หรือ URL ลิงก์
  externalUrl  String?
  fileSize     Int?
  mimeType     String?
  uploadedBy   BigInt?
  uploadedAt   DateTime @default(now())

  @@unique([schoolId, academicYear, documentType, userId])
  @@index([schoolId, academicYear])
  @@index([userId, schoolId, academicYear])
  @@map("pateacherdocument")
}

/// ส่ง SAR ครู — ครู 1 คน 1 ไฟล์ ต่อโรงเรียน ต่อปีการศึกษา (logic เหมือน PA 1/ส, 2/ส, 3/ส)
model TeacherSarDocument {
  id           BigInt   @id @default(autoincrement())
  school       School   @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  user         User     @relation("TeacherSarDocumentOwner", fields: [userId], references: [id])
  userId       BigInt
  academicYear Int // ปีการศึกษา (พ.ศ.)
  fileName     String
  storageType  String   @default("URL")
  storagePath  String?
  externalUrl  String?
  fileSize     Int?
  mimeType     String?
  uploadedBy   BigInt?
  uploadedAt   DateTime @default(now())

  @@unique([schoolId, academicYear, userId])
  @@index([schoolId, academicYear])
  @@index([userId, schoolId, academicYear])
  @@map("teachersardocument")
}

/// ID plan ของครู — ครู 1 คน 1 รายการ ต่อโรงเรียน ต่อปีการศึกษา
model TeacherIdPlan {
  id           BigInt   @id @default(autoincrement())
  school       School   @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  user         User     @relation("TeacherIdPlanOwner", fields: [userId], references: [id])
  userId       BigInt
  academicYear Int // ปีการศึกษา (พ.ศ.)
  idPlanCode   String // รหัสแผน / ID plan
  note         String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, academicYear, userId])
  @@index([schoolId, academicYear])
  @@index([userId, schoolId, academicYear])
  @@map("teacheridplan")
}

/// บันทึกการสอนชุมชน — ภาคเรียนละไม่เกิน 1 ฉบับต่อ 1 คน (อ้างอิง template docref/pp5.pdf)
model CommunityTeachingRecord {
  id           BigInt    @id @default(autoincrement())
  school       School    @relation(fields: [schoolId], references: [sc_id])
  schoolId     BigInt
  user         User      @relation("CommunityTeachingRecordOwner", fields: [userId], references: [id])
  userId       BigInt
  academicYear Int // ปีการศึกษา (พ.ศ.)
  semester     Int // ภาคเรียนที่ 1 หรือ 2
  title        String? // ชื่อกิจกรรม/หัวข้อ
  activityDate DateTime? // วันที่จัดกิจกรรม
  location     String? // สถานที่
  summary      String?   @db.Text // สรุปผล/รายละเอียด
  templateData Json? // ข้อมูลเพิ่มตาม template pp5.pdf (กรอกแล้ว)
  fileName     String?
  storageType  String    @default("URL")
  storagePath  String?
  externalUrl  String?
  fileSize     Int?
  mimeType     String?
  uploadedBy   BigInt?
  uploadedAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([schoolId, academicYear, semester, userId])
  @@index([schoolId, academicYear, semester])
  @@index([userId, schoolId, academicYear])
  @@map("communityteachingrecord")
}

// =============================================================================
// โครงการ (โปรแกรมเสริม) — รายงานโครงการ สรุปการดำเนินโครงการ อ้างอิงนโยบาย สพฐ / ตัวชี้วัด QA・PA
// =============================================================================

/// นโยบาย สพฐ รายปี (สำหรับอ้างอิงในโครงการ)
model OBECPolicy {
  id            BigInt    @id @default(autoincrement())
  fiscalYear    Int // ปีงบประมาณ (เช่น 2567)
  code          String // รหัส/เลขข้อ นโยบาย เช่น "นโยบายที่ 1"
  nameTh        String // ชื่อนโยบาย
  descriptionTh String?   @db.Text
  sortNo        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@unique([fiscalYear, code])
  @@index([fiscalYear])
  @@map("obecpolicy")
}

/// โครงการ — รายละเอียดการบันทึกโครงการ
model Project {
  id                BigInt        @id @default(autoincrement())
  school            School        @relation(fields: [schoolId], references: [sc_id])
  schoolId          BigInt // รหัสโรงเรียน (sc_id)
  code              String // รหัสโครงการ
  academicYear      Int // ปีการศึกษา (พ.ค.→เม.ย.)
  fiscalYear        Int // ปีงบประมาณ (ต.ค.→ก.ย.)
  responsibleUser   User?         @relation("ProjectResponsible", fields: [responsibleUserId], references: [id])
  responsibleUserId BigInt? // รหัสผู้รับผิดชอบโครงการ (user id)
  obePolicy         OBECPolicy?   @relation(fields: [obePolicyId], references: [id])
  obePolicyId       BigInt? // สอดคล้องกับ นโยบาย สพฐ ข้อใด
  qaIndicator       QAIndicator?  @relation(fields: [qaIndicatorId], references: [id])
  qaIndicatorId     BigInt? // สอดคล้องกับ ตัวชี้วัดการประกันคุณภาพ ใด
  paIndicator       PAIndicator?  @relation(fields: [paIndicatorId], references: [id])
  paIndicatorId     BigInt? // สอดคล้องกับ ตัวชี้วัด PA ใด
  title             String // ชื่อโครงการ
  description       String?       @db.Text
  status            ProjectStatus @default(DRAFT)
  del               Boolean       @default(false)
  createdBy         BigInt?
  updatedBy         BigInt?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  files             ProjectFile[]

  @@unique([schoolId, code, academicYear])
  @@index([schoolId, academicYear])
  @@index([schoolId, fiscalYear])
  @@index([responsibleUserId])
  @@map("project")
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// ไฟล์โครงการ — รายงานโครงการ / สรุปการดำเนินโครงการ (PDF พร้อมลายเซ็นอิเล็กทรอนิกส์)
model ProjectFile {
  id                BigInt          @id @default(autoincrement())
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         BigInt
  school            School          @relation(fields: [schoolId], references: [sc_id])
  schoolId          BigInt
  fileType          ProjectFileType // PROJECT_REPORT | EXECUTION_SUMMARY
  fileName          String
  mimeType          String? // application/pdf
  fileSize          Int?
  storagePath       String? // path ใน uploads
  externalUrl       String?
  signedAt          DateTime? // วันที่ลงลายเซ็นอิเล็กทรอนิกส์
  signedBy          BigInt? // user id ผู้ลงลายเซ็น
  signatureMetadata Json? // ข้อมูลลายเซ็น (เช่น hash, method)
  uploadedBy        BigInt?
  uploadedAt        DateTime        @default(now())
  del               Boolean         @default(false)

  @@index([projectId])
  @@index([projectId, fileType])
  @@index([schoolId])
  @@map("projectfile")
}

enum ProjectFileType {
  PROJECT_REPORT // รายงานโครงการ
  EXECUTION_SUMMARY // สรุปการดำเนินโครงการ
}
